# ==========================================================
# Panela de Barro — variáveis de ambiente
# Copie para .env e preencha:  cp .env.example .env
# ==========================================================

# --- Banco de dados (PostgreSQL) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=estoque_db

# Host e porta do banco.
# Docker Compose: já injetados (POSTGRES_HOST=db, POSTGRES_PORT=5432) — pode deixar
# comentado. Rodando o backend FORA do Docker (uvicorn direto), descomente:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Segurança / JWT ---
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# --- Usuário administrador inicial ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha-admin
ADMIN_DISPLAY_NAME=Admin

# --- Licença (entregue pelo time) ---
LICENSE_KEY=cole-sua-chave-de-licenca-aqui
