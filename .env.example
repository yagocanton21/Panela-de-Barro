# --- Banco PostgreSQL (usado apenas no Docker local) ---
# No deploy AWS, estes valores são substituídos pelo endpoint do RDS
POSTGRES_USER=admin
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=estoque_db

# --- Chave para assinar tokens JWT da aplicação ---
# Gere uma aleatória:
SECRET_KEY=vamos_gerar_e_te_enviar

# --- Admin inicial (criado no primeiro start) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=defina-uma-senha
ADMIN_DISPLAY_NAME=Admin

# --- Licença obrigatória (entregue separadamente pelo time) ---
# Sem uma LICENSE_KEY válida o backend não inicia.
LICENSE_KEY=cole-aqui-a-chave-de-licenca
