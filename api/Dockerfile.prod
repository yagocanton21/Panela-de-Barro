FROM python:3.10-alpine

WORKDIR /backend

# Adiciona dependências do sistema e limpa o cache em uma única camada
RUN apk update && apk add --no-cache \
    postgresql-dev \
    gcc \
    musl-dev \
    curl \
    && rm -rf /var/cache/apk/*

COPY api/requirements.txt .

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir -r requirements.txt

# Copia a pasta api (código, alembic, entrypoint) — mesmo layout do repo
COPY api/ api/
RUN chmod +x api/entrypoint.sh

# Cria usuário não-root e ajusta permissões
RUN adduser -D appuser && chown -R appuser:appuser /backend
USER appuser

EXPOSE 8000

ENTRYPOINT ["./api/entrypoint.sh"]
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
